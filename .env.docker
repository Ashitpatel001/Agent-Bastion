# ============================================================
# ABSs v2.0 — Docker Deployment Environment Configuration
# ============================================================
# Copy this file to .env before running: docker compose up --build
# 
#   cp .env.docker .env
#   # Edit .env with your real API keys
#   docker compose up --build
# ============================================================

# ── API Keys (REQUIRED) ──────────────────────────────────────
# At minimum, set GOOGLE_API_KEY for the XAI security explanations
# and one of OPENAI_API_KEY or GEMINI_API_KEY for the agent LLM.

VIRUSTOTAL_API_KEY=
OPENAI_API_KEY=
BROWSER_USE_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=          # Same as GEMINI_API_KEY — required by XAI worker

# ── PostgreSQL ────────────────────────────────────────────────
# These configure the postgres container AND are interpolated
# into DATABASE_URL by docker-compose.yml automatically.
POSTGRES_USER=abs_user
POSTGRES_PASSWORD=abs_secret_change_me
POSTGRES_DB=abs_db
POSTGRES_PORT=5432

# Database tuning (used by SQLAlchemy engine)
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND are set in
# docker-compose.yml pointing to the redis service container.

# ── XAI Worker ────────────────────────────────────────────────
XAI_MODEL=gemini-2.0-flash

# ── Agent Worker ──────────────────────────────────────────────
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=25

# ── Service Ports (host-side) ─────────────────────────────────
API_PORT=8000
DASHBOARD_PORT=8501
FLOWER_PORT=5555
ATTACK_PORT=5001
