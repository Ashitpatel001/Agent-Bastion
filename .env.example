# ==============================================================================
# Agent-Bastion v2.0
# Universal Environment Configuration (.env.example)
#
# SAME FILE FOR:
# - Local Development Mode
# - Production Mode
#
# Only the values change.
# ==============================================================================


# ==============================================================================
# 1. DEPLOYMENT MODE
# ==============================================================================

# development | production
ENV=development
ENVIRONMENT=development


# ==============================================================================
# 2. APPLICATION PORTS
# ==============================================================================

API_PORT=8000
FRONTEND_PORT=3000

CADDY_DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443


# ==============================================================================
# 3. AUTHENTICATION & SECURITY
# ==============================================================================

# MUST CHANGE IN PRODUCTION

JWT_SECRET_KEY=change_me_in_production_with_64_char_random_secret
SECRET_KEY=change_me_in_production_with_64_char_random_secret

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ==============================================================================
# 4. DATABASE CONFIGURATION
# ==============================================================================

POSTGRES_USER=abs_user

# MUST CHANGE IN PRODUCTION
POSTGRES_PASSWORD=change_me

POSTGRES_DB=abs_db

DATABASE_URL=postgresql+asyncpg://abs_user:change_me@postgres:5432/abs_db


# ==============================================================================
# 5. REDIS + CELERY
# ==============================================================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

REDIS_URL=redis://redis:6379/0


# ==============================================================================
# 6. DATABASE POOLING
# ==============================================================================

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# ==============================================================================
# 7. OBSERVABILITY
# ==============================================================================

GRAFANA_ADMIN_USER=admin

# MUST CHANGE IN PRODUCTION
GRAFANA_ADMIN_PASSWORD=change_me

GRAFANA_PORT=3001


# ==============================================================================
# 8. LLM PROVIDERS
# ==============================================================================

# PRIMARY PROVIDER (RECOMMENDED)
#
# Agent-Bastion officially recommends GROQ.
#
# Leave other providers empty if unused.

PRIMARY_LLM_PROVIDER=groq

GROQ_API_KEY=

# Recommended models

GROQ_AGENT_MODEL=llama-3.3-70b-versatile
GROQ_XAI_MODEL=llama-3.1-8b-instant



# OPTIONAL PROVIDERS

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ==============================================================================
# 9. AGENT EXECUTION
# ==============================================================================

AGENT_MAX_STEPS=25


# ==============================================================================
# 10. BROWSER AUTOMATION
# ==============================================================================

# OPTIONAL

PLAYWRIGHT_HEADLESS=true
ENABLE_BROWSER_EXECUTION=false
ENABLE_AGENT_RUNTIME=true

BROWSER_USE_API_KEY=
BROWSER_USE_MODEL=bu-latest


# ==============================================================================
# 11. THREAT INTELLIGENCE
# ==============================================================================

# OPTIONAL

VIRUSTOTAL_API_KEY=


# ==============================================================================
# 12. WORKER SETTINGS
# ==============================================================================

WORKER_MAX_CONCURRENT_TASKS_PER_TENANT=5

WORKER_MAX_RETRIES=3

WORKER_TIMEOUT_SECONDS=300


# ==============================================================================
# 13. SECURITY FEATURES
# ==============================================================================

ENABLE_SECURITY_ENGINE=true
ENABLE_OBSERVABILITY=true
ENABLE_AUDIT_TRAIL=true
ENABLE_RBAC=true
ENABLE_MULTI_TENANCY=true
ENABLE_WAF=true


# ==============================================================================
# 14. PRODUCTION FEATURES
# ==============================================================================

# LOCAL DEVELOPMENT

# HTTPS disabled
# Cloudflare disabled
# DNS disabled


# PRODUCTION

# HTTPS enabled automatically by Caddy
# Cloudflare optional
# Custom domains supported


ENABLE_CLOUDFLARE=false
ENABLE_TLS=true