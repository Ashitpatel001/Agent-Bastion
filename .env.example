# Secure Agent Browser Security Suite - Configuration

# 1. VirusTotal API Key
VIRUSTOTAL_API_KEY=

# 2. OpenAI API Key (Required for Agent Logic)
OPENAI_API_KEY=your_openai_api_key_here

# 3. Browser Use API Key (Required for Browser Automation)
BROWSER_USE_API_KEY=your_browser_use_api_key_here

# 4. Gemini API Key (For Dual-LLM Guardrail Auditing)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================================================
# ABSs v2.0 — Multi-Tenant Proxy Configuration
# ==========================================================================

# 5. Database URL
# Default: SQLite (free, zero-config, perfect for local dev).
# Production: postgresql+asyncpg://user:password@host:5432/abs_db
DATABASE_URL=sqlite+aiosqlite:///./abs_security.db

# 6. Database options
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================================================
# Component 4 — Background Workers (Celery + Redis)
# ==========================================================================

# 7. Redis (message broker for Celery task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 8. XAI (Explainable AI) Worker
# Model used for generating security explanations
XAI_MODEL=gemini-2.0-flash
# Set GOOGLE_API_KEY above (GEMINI_API_KEY) — used by the XAI worker

# 9. Agent Worker
# LLM model used for agent execution (supports openai or gemini models)
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=25
