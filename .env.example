# ==============================================================================
# Agent-Bastion v2.0 — Production Layer For Autonomous AI Agents
# Universal Environment Configuration Template (.env.example)
#
# INSTRUCTIONS (5-Minute Quickstart):
# 1. Copy this file to `.env`: cp .env.example .env
# 2. Run local dev stack:      docker compose -f docker-compose.dev.yml up --build
# 3. Or run production stack:  docker compose up -d --build
# ==============================================================================

# ── 1. Environment & API Gateway ──────────────────────────────────────────────
ENV=development
ENVIRONMENT=development
API_PORT=8000
FRONTEND_PORT=3000

# ── 2. Cryptographic Secrets (MUST be changed in Production!) ─────────────────
# Generate via: openssl rand -hex 32 OR python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=abs_dev_secret_key_change_me_in_prod_at_least_32_chars
SECRET_KEY=abs_dev_secret_key_change_me_in_prod_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 3. Database & Cache Connection Strings (Docker Internal Routing) ──────────
POSTGRES_USER=abs_user
POSTGRES_PASSWORD=abs_secret_change_me
POSTGRES_DB=abs_db
DATABASE_URL=postgresql+asyncpg://abs_user:abs_secret_change_me@postgres:5432/abs_db

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0

# Database connection pool settings
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── 4. Reverse Proxy & Domain Routing (Caddy) ─────────────────────────────────
CADDY_DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── 5. Observability & Security Monitoring Credentials ────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=abs_grafana_secret_2026
GRAFANA_PORT=3001

# ── 6. External AI Model Keys (Optional for local testing & sandbox) ──────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
BROWSER_USE_API_KEY=
VIRUSTOTAL_API_KEY=

# ── 7. Worker Execution Limits & Models ───────────────────────────────────────
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=25
XAI_MODEL=gemini-2.0-flash
