# ==============================================================================
# ABSs v2.0 — Production Environment Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env`: cp .env.example .env
# 2. Fill in all required values before launching the application.
# 3. NEVER commit your `.env` file to version control.
# ==============================================================================

# ── 1. API Gateway & Authentication ───────────────────────────────────────────
# Secret key used for cryptographic signing, session tokens, and security hashes.
# MUST be a strong, randomly generated secret (e.g., openssl rand -hex 32).
# Do NOT use default or sample values in production.
SECRET_KEY=

# Environment mode: development, staging, or production
ENVIRONMENT=development

# API port for local development or container binding
API_PORT=8000

# ── 2. Database Configuration (PostgreSQL Async) ──────────────────────────────
# Async SQLAlchemy database connection string.
# Production must use PostgreSQL with asyncpg driver.
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/abs_db

# Database connection pool settings
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── 3. Background Workers (Celery + Redis) ────────────────────────────────────
# Redis connection URLs for Celery task dispatch queue and async result backend.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── 4. External LLM Providers & API Keys ──────────────────────────────────────
# OpenAI API Key used by agent workers for browser execution logic.
OPENAI_API_KEY=

# Google Gemini API Key used for dual-LLM constitutional guardrails and XAI explanations.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Groq API Key for ultra-low latency inference fallback.
GROQ_API_KEY=

# ChatBrowserUse Cloud API Key for native cloud browser automation.
BROWSER_USE_API_KEY=
BROWSER_USE_MODEL=bu-latest

# ── 5. External Threat Intelligence Providers ─────────────────────────────────
# VirusTotal API Key for real-time URL reputation and payload scanning.
VIRUSTOTAL_API_KEY=

# ── 6. Worker Execution Parameters ────────────────────────────────────────────
# Model selection for agent and XAI explanation workers.
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=25
XAI_MODEL=gemini-2.0-flash
