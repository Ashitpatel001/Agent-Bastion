# ============================================================
# Agent-Bastion v2.0 — Production Layer For Autonomous AI Agents
# Local Development Caddy Reverse Proxy Configuration (Caddyfile.dev)
# Requirements: HTTP ONLY, localhost, NO TLS, Real Service Routing
# ============================================================

{
	# Global options for local development
	admin off
	auto_https off
}

http://localhost:80, http://127.0.0.1:80, http://localhost {
	# Security headers adjusted for local development
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API Gateway Routing (Real API instances only)
	handle /api/* {
		reverse_proxy http://api:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto http
		}
	}

	# OpenAPI / Swagger Documentation
	handle /docs* {
		reverse_proxy http://api:8000
	}
	handle /openapi.json* {
		reverse_proxy http://api:8000
	}

	# Health, Liveness, and Readiness Probes
	handle /health* {
		reverse_proxy http://api:8000
	}
	handle /live* {
		reverse_proxy http://api:8000
	}
	handle /ready* {
		reverse_proxy http://api:8000
	}

	# Prometheus Metrics Routing (Enabled for local dev & testing)
	handle /metrics* {
		reverse_proxy http://api:8000 {
			header_up x-internal-metrics "true"
		}
	}

	# Observability & Infrastructure APIs
	handle /observability/* {
		reverse_proxy http://api:8000
	}

	# Next.js Frontend Routing
	handle /* {
		reverse_proxy http://frontend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto http
		}
	}

	log {
		output stdout
		format json
	}
}
