# ==============================================================================
# Agent-Bastion v2.0 — Production Layer For Autonomous AI Agents
# Dockerfile.frontend — Next.js 15 Real-Time Developer Dashboard
#
# Responsibility: Builds and serves the Next.js frontend UI container.
# Supports both 'dev' (live reload) and 'runner' (production optimized) stages.
# ==============================================================================

FROM node:20-alpine AS base
WORKDIR /app

# ------------------------------------------------------------------------------
# 1. Dependencies Stage
# ------------------------------------------------------------------------------
FROM base AS deps
COPY abs-frontend/package.json abs-frontend/package-lock.json ./
RUN npm ci

# ------------------------------------------------------------------------------
# 2. Local Development Stage (Live Reloading)
# ------------------------------------------------------------------------------
FROM base AS dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY abs-frontend/ .
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["npm", "run", "dev"]

# ------------------------------------------------------------------------------
# 3. Production Build Stage
# ------------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY abs-frontend/ .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ------------------------------------------------------------------------------
# 4. Production Runtime Stage (Non-root minimal runner)
# ------------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["npm", "run", "start"]
